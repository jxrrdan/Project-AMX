# Multi-stage build for the NestJS API image referenced by Ams-Compute (ECR repo: ams-api).
# Build context is the repository root:  docker build -f apps/api/Dockerfile -t ams-api .
#
# Targets: `runner` (default, the API) and `migrate` (one-off `prisma migrate deploy`, run as an ECS
# task before each rollout). CI builds both (.github/workflows/ci.yml builds the image on every PR).

# --- Build stage: compile the app and prune to production-only deps --------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /workspace

# Prisma needs OpenSSL to generate/run its query engine.
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate --schema apps/api/prisma/schema.prisma \
 && npx nx build api --configuration=production \
 && npx nx prune api

# --- Migration target: has the Prisma CLI; run once per release, never as a long-lived service -----
FROM build AS migrate
ENV NODE_ENV=production
CMD ["node", "apps/api/scripts/migrate.js"]

# --- Runtime stage: minimal image with only what the API needs ------------------------------------
FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production
WORKDIR /app

# openssl for Prisma; chromium for server-side PDF rendering (PDF_DRIVER=puppeteer).
RUN apt-get update && apt-get install -y --no-install-recommends openssl chromium fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Pruned production dependency manifest for just the API (generated by `nx prune`).
COPY --from=build /workspace/dist/apps/api/package.json /workspace/dist/apps/api/package-lock.json ./
RUN npm ci --omit=dev

# Compiled application, the Prisma schema, and the generated Prisma client.
COPY --from=build /workspace/dist/apps/api ./
COPY --from=build /workspace/apps/api/prisma ./prisma
COPY --from=build /workspace/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /workspace/node_modules/@prisma/client ./node_modules/@prisma/client

# Run as the unprivileged `node` user that ships with the base image, never root.
RUN mkdir -p /app/.data && chown -R node:node /app
USER node

EXPOSE 3000

# Container-level liveness probe (the ALB/ECS health check hits the same endpoint).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migrations are applied by a separate one-off step (the `migrate` service in docker-compose.prod.yml,
# or an ECS run-task before rollout) rather than here, so replicas never race to migrate and the
# runtime image needs no Prisma CLI. This container only runs the compiled server.
CMD ["node", "main.js"]
