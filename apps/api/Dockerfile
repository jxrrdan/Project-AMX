# Multi-stage build for the NestJS API image referenced by Ams-Compute (ECR repo: ams-api).
# Build context is the repository root:  docker build -f apps/api/Dockerfile -t ams-api .
#
# NOTE: provided for the CI/CD pipeline (.github/workflows/deploy.yml) — it has not been built in
# this repo's sandbox (no Docker daemon). Treat it as the intended image, to validate on first CI run.

# --- Build stage: compile the app and prune to production-only deps --------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /workspace

# Prisma needs OpenSSL to generate/run its query engine.
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate --schema apps/api/prisma/schema.prisma \
 && npx nx build api --configuration=production \
 && npx nx prune api

# --- Runtime stage: minimal image with only what the API needs ------------------------------------
FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# Pruned production dependency manifest for just the API (generated by `nx prune`).
COPY --from=build /workspace/dist/apps/api/package.json /workspace/dist/apps/api/package-lock.json ./
RUN npm ci --omit=dev

# Compiled application, the Prisma schema, and the generated Prisma client.
COPY --from=build /workspace/dist/apps/api ./
COPY --from=build /workspace/apps/api/prisma ./prisma
COPY --from=build /workspace/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /workspace/node_modules/@prisma/client ./node_modules/@prisma/client

EXPOSE 3000

# Apply any pending migrations, then start. In a stricter setup migrations run as a separate
# one-off task/init container so app tasks never race to migrate — see deploy.yml.
CMD ["sh", "-c", "npx prisma migrate deploy --schema ./prisma/schema.prisma && node main.js"]
