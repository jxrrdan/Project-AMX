// AMS — Agent Management System
// Prisma schema modelling all 16 functional modules of the AMS Feature Specification v3.1.
// Every business table carries dealerId for multi-tenancy; PostgreSQL row-level security
// (see infra/cdk) enforces isolation at the DB layer in production. Locally, application-level
// scoping (TenantGuard + Prisma middleware) is the enforcement path — see apps/api/src/common.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Module 7 — Admin, User Management & RBAC, and core tenancy
// ---------------------------------------------------------------------------

/// A dealer group (holding company) owning multiple outlets, potentially across several
/// franchise brands — e.g. a group that owns both BMW and MINI outlets. Optional: most dealers
/// in this app have no group at all (franchiseId/groupId are nullable end-to-end).
model Group {
  id              String   @id @default(uuid())
  name            String
  logoUrl         String?
  primaryColour   String?
  secondaryColour String?
  /// Unguessable invite secret — a franchise joins this group by presenting this code (never its
  /// raw id), same "capability token, not an enumerable id" pattern as webhookToken elsewhere.
  /// Only ever returned to a caller whose own dealer already belongs to this group.
  joinCode        String   @unique @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  franchises           Franchise[]
  documentTemplates    DocumentTemplate[]
  actionTriggers       ActionTrigger[]
  vehicleModelMetadata VehicleModelMetadata[]

  @@map("groups")
}

/// A brand/franchise (e.g. "BMW", "MINI") — sits between Group and Dealer. A dealer's franchise
/// determines which franchise-level (and, transitively, group-level) config it inherits.
model Franchise {
  id              String   @id @default(uuid())
  groupId         String?
  group           Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name            String
  brandCode       String?
  logoUrl         String?
  primaryColour   String?
  secondaryColour String?
  /// Unguessable invite secret — a dealer joins this franchise by presenting this code (never its
  /// raw id). Without this, any ADMIN:EDIT user could look up any franchise/group id and attach
  /// their own dealer to it, inheriting read/write access to that org's shared document templates
  /// and Action Triggers — this code is what proves the caller was actually invited.
  joinCode        String   @unique @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dealers              Dealer[]
  documentTemplates    DocumentTemplate[]
  actionTriggers       ActionTrigger[]
  vehicleModelMetadata VehicleModelMetadata[]

  @@map("franchises")
}

/// Cached reference metadata (body type, fuel options, segment, etc.) for a vehicle model/derivative,
/// fetched from an OEM metadata API the first time an inbound integration payload (REST or MQTT)
/// mentions a model AMX doesn't already know about — see IntegrationIngestService. Scoped like
/// DocumentTemplate/ActionTrigger (most-specific-wins DEALER > FRANCHISE > GROUP), but the row is
/// written by the ingest engine itself rather than authored by a user.
model VehicleModelMetadata {
  id          String      @id @default(uuid())
  scope       ConfigScope
  dealerId    String?
  dealer      Dealer?     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  franchiseId String?
  franchise   Franchise?  @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Normalised (trimmed, lower-cased) model/derivative name — the cache key.
  modelKey    String
  /// Whatever the metadata API returned — body type, fuel options, doors, segment, etc.
  data        Json
  createdAt   DateTime    @default(now())

  @@unique([dealerId, franchiseId, groupId, modelKey])
  @@map("vehicle_model_metadata")
}

/// Which of the three tenancy levels a piece of shared config (document template, action
/// trigger) belongs to — resolution always prefers the most specific: DEALER, then FRANCHISE,
/// then GROUP, then a built-in fallback.
enum ConfigScope {
  GROUP
  FRANCHISE
  DEALER
}

model Dealer {
  id                 String     @id @default(uuid())
  name               String
  franchiseCode      String?
  franchiseId        String?
  franchise          Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  address            String?
  timeZone           String     @default("Europe/London")
  locale             String     @default("en-GB")
  subdomain          String     @unique
  risDealerId        String?
  awpWebhookUrl      String?
  logoUrl            String?
  primaryColour      String?
  secondaryColour    String?
  vatNumber          String?
  invoiceFooterNote  String?
  /// Used to compute AftersalesInvoice's labour total — see AftersalesInvoiceService.
  labourRatePerHour  Decimal    @default(95.00) @db.Decimal(10, 2)
  /// Unguessable, revocable access token for the public workshop TV board (§2.3) — deliberately
  /// NOT the dealer's own id, since that id is published elsewhere (embeddable widget URLs).
  workshopBoardToken String     @unique @default(uuid())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  users                   User[]
  roles                   Role[]
  moduleLicenses          ModuleLicense[]
  vehicles                Vehicle[]
  pdiJobs                 PdiJob[]
  handoverAppointments    HandoverAppointment[]
  bays                    Bay[]
  jobCards                JobCard[]
  capacityBlocks          CapacityBlock[]
  serviceBookings         ServiceBooking[]
  parts                   Part[]
  stockMovements          StockMovement[]
  purchaseOrders          PurchaseOrder[]
  usedVehicles            UsedVehicle[]
  warrantyClaims          WarrantyClaim[]
  contacts                Contact[]
  leads                   Lead[]
  emailTemplates          EmailTemplate[]
  documentTemplates       DocumentTemplate[]
  workflows               Workflow[]
  vhcInspections          VhcInspection[]
  listingPlatforms        ListingPlatform[]
  accountingIntegrations  AccountingIntegration[]
  courtesyVehicles        CourtesyVehicle[]
  financeProducts         FinanceProduct[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  aiConversations         AiConversation[]
  documentSequences       DocumentSequence[]
  invitations             Invitation[]
  integrationConnectors   IntegrationConnector[]
  customFieldDefinitions  CustomFieldDefinition[]
  uiScreenDefinitions     UiScreenDefinition[]
  batchJobRuns            BatchJobRun[]
  actionTriggers          ActionTrigger[]
  jobCardPartRequirements JobCardPartRequirement[]
  aftersalesInvoices      AftersalesInvoice[]
  customerInvoices        CustomerInvoice[]
  vehicleModelMetadata    VehicleModelMetadata[]
  newCarSales             NewCarSale[]
  vehicleConditionReports VehicleConditionReport[]
  technicianSkills        TechnicianSkill[]
  technicianAvailability  TechnicianAvailability[]

  @@map("dealers")
}

enum SystemRole {
  DEALER_PRINCIPAL
  GENERAL_MANAGER
  SALES_MANAGER
  SALES_EXECUTIVE
  WORKSHOP_CONTROLLER
  SERVICE_ADVISOR
  TECHNICIAN
  PARTS_MANAGER
  ACCOUNTS
}

model Role {
  id         String      @id @default(uuid())
  dealerId   String
  dealer     Dealer      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name       String
  systemRole SystemRole?
  isCustom   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([dealerId, name])
  @@map("roles")
}

enum ModuleKey {
  NEW_CAR_PDI
  WORKSHOP
  PARTS
  USED_CARS
  WARRANTY
  DASHBOARD
  ADMIN
  CRM
  VHC
  LISTINGS
  ACCOUNTING
  COURTESY_FLEET
  FI
  AI_INSIGHTS
  AI_CHATBOT
  GENERAL_LEDGER
  OEM_INTEGRATIONS
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
  APPROVE
}

model RolePermission {
  id     String           @id @default(uuid())
  roleId String
  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module ModuleKey
  action PermissionAction

  @@unique([roleId, module, action])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  dealerId     String
  dealer       Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  email        String
  phone        String?
  firstName    String
  lastName     String
  passwordHash String
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles                   UserRole[]
  moduleOverrides         UserModuleOverride[]
  sessions                UserSession[]
  loginAudits             LoginAudit[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  assignedVehicles        Vehicle[]                @relation("AllocatedAdvisor")
  technicianJobCards      JobCard[]                @relation("AssignedTechnician")
  advisorJobCards         JobCard[]                @relation("ServiceAdvisor")
  timeEntries             JobCardTimeEntry[]
  jobCardLineClockEntries JobCardLineClockEntry[]  @relation("JobCardLineClockEntries")
  assignedLeads           Lead[]                   @relation("AssignedSalesperson")
  tasks                   CrmTask[]                @relation("TaskAssignee")
  warrantyClockEntries    WarrantyClockEntry[]
  technicianSkills        TechnicianSkill[]
  technicianAvailability  TechnicianAvailability[]

  @@unique([dealerId, email])
  @@map("users")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserModuleOverride {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module  ModuleKey
  action  PermissionAction
  allowed Boolean

  @@unique([userId, module, action])
  @@map("user_module_overrides")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@map("user_sessions")
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("login_audits")
}

model Invitation {
  id         String    @id @default(uuid())
  dealerId   String
  dealer     Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  email      String
  roleIds    String[]
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("invitations")
}

model ModuleLicense {
  id                       String    @id @default(uuid())
  dealerId                 String
  dealer                   Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  module                   ModuleKey
  enabled                  Boolean   @default(true)
  stripeSubscriptionItemId String?
  activatedAt              DateTime  @default(now())

  @@unique([dealerId, module])
  @@map("module_licenses")
}

model AuditLog {
  id         String    @id @default(uuid())
  dealerId   String
  dealer     Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  module     ModuleKey
  action     String
  recordType String
  recordId   String
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now())

  @@index([dealerId, module, createdAt])
  @@map("audit_logs")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id        String              @id @default(uuid())
  dealerId  String
  dealer    Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  eventType String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@map("notifications")
}

model DocumentSequence {
  id         String @id @default(uuid())
  dealerId   String
  dealer     Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  docType    String
  prefix     String
  year       Int
  nextNumber Int    @default(1)

  @@unique([dealerId, docType, year])
  @@map("document_sequences")
}

enum BatchJobStatus {
  RUNNING
  SUCCESS
  ERROR
}

/// Audit trail for scheduled maintenance jobs (nightly/monthly cron — see BatchJobsService),
/// one row per dealer per run, same "run log" pattern as IntegrationRunLog.
model BatchJobRun {
  id           String         @id @default(uuid())
  dealerId     String
  dealer       Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  jobName      String
  status       BatchJobStatus @default(RUNNING)
  summary      String?
  errorMessage String?
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([dealerId, jobName, startedAt])
  @@map("batch_job_runs")
}

// ---------------------------------------------------------------------------
// Module 1 — New Car Stock & PDI Pipeline
// ---------------------------------------------------------------------------

enum VehiclePipelineStatus {
  ORDERED
  IN_PRODUCTION
  IN_TRANSIT
  ARRIVED
  PDI_SCHEDULED
  PDI_COMPLETE
  READY_FOR_HANDOVER
  DELIVERED
}

model Vehicle {
  id                 String                @id @default(uuid())
  dealerId           String
  dealer             Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vin                String
  model              String
  colour             String?
  customerName       String?
  eta                DateTime?
  status             VehiclePipelineStatus @default(ORDERED)
  allocatedAdvisorId String?
  allocatedAdvisor   User?                 @relation("AllocatedAdvisor", fields: [allocatedAdvisorId], references: [id], onDelete: SetNull)
  risOrderRef        String?
  /// Values for CustomFieldDefinition(entity: VEHICLE) — written by the OEM Integration Hub's
  /// field-mapping engine; keyed by CustomFieldDefinition.key.
  customFields       Json                  @default("{}")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  pdiJobs              PdiJob[]
  handoverAppointments HandoverAppointment[]
  jobCards             JobCard[]
  warrantyClaims       WarrantyClaim[]
  financeProducts      DealFinanceProduct[]
  sales                NewCarSale[]

  @@unique([dealerId, vin])
  @@map("vehicles")
}

/// Whether a new-car sale is RETAIL (the dealer buys and sells the vehicle itself, taking its own
/// margin — the traditional model) or AGENCY (the OEM is the contracting seller to the customer;
/// the dealer facilitates the order and earns a commission instead of a margin — the model several
/// manufacturers, BMW included, have been rolling out for some markets/channels). Either way a
/// trade-in the customer brings in is the DEALER's own purchase, never the OEM's, so it's handled
/// identically regardless of saleModel — see PartExchangeAppraisal.newCarSaleId.
enum SaleModel {
  RETAIL
  AGENCY
}

/// A vehicle can have more than one NewCarSale over time (an attempt that falls through gets
/// INVALIDATED, same lifecycle as DealSheet, so the vehicle can be re-sold without losing the
/// audit trail of the earlier attempt).
model NewCarSale {
  id                String          @id @default(uuid())
  dealerId          String
  dealer            Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleId         String
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status            DealSheetStatus @default(ACTIVE)
  saleModel         SaleModel       @default(RETAIL)
  sellingPrice      Decimal         @db.Decimal(10, 2)
  partExchangeValue Decimal?        @db.Decimal(10, 2)
  /// Only meaningful when saleModel = AGENCY — the fee the OEM pays the dealer for facilitating
  /// this sale, since the dealer isn't taking a margin on the vehicle itself.
  agencyCommission  Decimal?        @db.Decimal(10, 2)
  pdfUrl            String?
  invalidatedAt     DateTime?
  invalidatedReason String?
  createdAt         DateTime        @default(now())

  tradeIn PartExchangeAppraisal?

  @@map("new_car_sales")
}

enum PdiStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
}

model PdiJob {
  id               String    @id @default(uuid())
  dealerId         String
  dealer           Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  scheduledDate    DateTime
  bayId            String?
  bay              Bay?      @relation(fields: [bayId], references: [id], onDelete: SetNull)
  technicianId     String?
  estimatedMinutes Int       @default(60)
  status           PdiStatus @default(SCHEDULED)
  awpJobRef        String?
  jobCardId        String?   @unique
  jobCard          JobCard?  @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  signedOffAt      DateTime?
  signedOffBy      String?
  checklistPdfUrl  String?
  createdAt        DateTime  @default(now())

  checklistItems PdiChecklistItem[]

  @@map("pdi_jobs")
}

enum PdiItemRating {
  PASS
  ADVISORY
  FAIL
}

model PdiChecklistItem {
  id        String         @id @default(uuid())
  pdiJobId  String
  pdiJob    PdiJob         @relation(fields: [pdiJobId], references: [id], onDelete: Cascade)
  category  String
  label     String
  rating    PdiItemRating?
  notes     String?
  photoUrls String[]
  sortOrder Int            @default(0)

  @@map("pdi_checklist_items")
}

enum HandoverType {
  NEW_CAR
  USED_CAR
}

model HandoverAppointment {
  id                      String       @id @default(uuid())
  dealerId                String
  dealer                  Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  type                    HandoverType
  vehicleId               String?
  vehicle                 Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  usedVehicleId           String?
  usedVehicle             UsedVehicle? @relation(fields: [usedVehicleId], references: [id], onDelete: SetNull)
  scheduledAt             DateTime
  advisorId               String?
  checklistJson           Json?
  signatureUrl            String?
  completedAt             DateTime?
  confirmationEmailSentAt DateTime?
  createdAt               DateTime     @default(now())

  @@map("handover_appointments")
}

// ---------------------------------------------------------------------------
// Module 2 — Workshop Scheduling
// ---------------------------------------------------------------------------

model Bay {
  id       String  @id @default(uuid())
  dealerId String
  dealer   Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name     String
  active   Boolean @default(true)

  jobCards       JobCard[]
  pdiJobs        PdiJob[]
  capacityBlocks CapacityBlock[]

  @@unique([dealerId, name])
  @@map("bays")
}

enum JobType {
  PDI
  SERVICE
  REPAIR
  WARRANTY
  MOT
}

/// The skill/specialism a job requires — drives technician capacity planning (see
/// TechnicianSkill/TechnicianAvailability below), independent of JobType (which describes the
/// nature of the visit, not who is qualified to do it).
enum JobCategory {
  MECHANICAL
  EV
  DIAGNOSTICS
  BODYSHOP
  TYRES_AND_ALIGNMENT
  MOT_TESTING
  VALETING
  GENERAL
}

/// Who ultimately pays for a job card — decides invoicing routing (§AftersalesInvoiceService):
/// RETAIL bills the customer, WARRANTY is claimed from the OEM via WarrantyClaim (never a customer
/// invoice), INTERNAL is a dealer-absorbed cost (goodwill, pre-delivery prep, demo damage) billed to
/// nobody externally.
enum JobBillingType {
  RETAIL
  WARRANTY
  INTERNAL
}

enum JobCardStatus {
  CREATED
  SCHEDULED
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETE
  INVOICED
}

model JobCard {
  id                   String         @id @default(uuid())
  dealerId             String
  dealer               Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerName         String
  contactId            String?
  contact              Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  vehicleId            String?
  vehicle              Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleReg           String?
  jobType              JobType
  category             JobCategory    @default(GENERAL)
  billingType          JobBillingType @default(RETAIL)
  description          String?
  estimatedHours       Decimal        @default(0) @db.Decimal(6, 2)
  status               JobCardStatus  @default(CREATED)
  bayId                String?
  bay                  Bay?           @relation(fields: [bayId], references: [id], onDelete: SetNull)
  assignedTechnicianId String?
  assignedTechnician   User?          @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  serviceAdvisorId     String?
  serviceAdvisor       User?          @relation("ServiceAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: SetNull)
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  awpJobRef            String?
  /// Set when this job card was auto-created from a customer approving a VHC upsell item —
  /// closes the loop back to the inspection that recommended the work (see VhcService.respondToItem).
  sourceVhcItemId      String?        @unique
  sourceVhcItem        VhcItem?       @relation(fields: [sourceVhcItemId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  timeEntries       JobCardTimeEntry[]
  operationLines    JobCardOperationLine[]
  partAllocations   PartAllocation[]
  partRequirements  JobCardPartRequirement[]
  pdiJob            PdiJob?
  warrantyClaim     WarrantyClaim?
  vhcInspections    VhcInspection[]
  aftersalesInvoice AftersalesInvoice?
  conditionReports  VehicleConditionReport[]

  @@map("job_cards")
}

/// An itemised line of work within a job card (e.g. "Front brake pads", "Diagnose coolant leak"),
/// each independently clockable by whichever technician works it — the per-line breakdown a single
/// whole-job JobCardTimeEntry can't give you. A job card with no lines still uses the older
/// whole-job clocking (JobCardTimeEntry) unchanged; once it has lines, invoicing sums clocked time
/// from lines instead (see AftersalesInvoiceService.generate). For a WARRANTY-billed job, OEM claim
/// paperwork still goes through WarrantyOperationLine on the linked WarrantyClaim — this model is
/// for the workshop floor's own labour tracking, not the claim submission itself.
model JobCardOperationLine {
  id               String   @id @default(uuid())
  jobCardId        String
  jobCard          JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  description      String
  estimatedMinutes Int?
  createdAt        DateTime @default(now())

  clockEntries JobCardLineClockEntry[]

  @@map("job_card_operation_lines")
}

model JobCardLineClockEntry {
  id           String               @id @default(uuid())
  lineId       String
  line         JobCardOperationLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User                 @relation("JobCardLineClockEntries", fields: [technicianId], references: [id], onDelete: Cascade)
  clockOn      DateTime
  clockOff     DateTime?

  @@map("job_card_line_clock_entries")
}

/// A customer-facing invoice for a completed workshop job — labour (from JobCardTimeEntry) plus
/// parts (from PartAllocation) plus VAT. Generated via the same document-template system as the
/// used-car deal sheet (DocumentTemplateType.AFTERSALES_INVOICE), so a dealer/franchise/group can
/// brand it the same way. One invoice per job card.
model AftersalesInvoice {
  id            String   @id @default(uuid())
  dealerId      String
  dealer        Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  jobCardId     String   @unique
  jobCard       JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  invoiceNumber String
  /// True for a JobBillingType.INTERNAL job — a dealer-absorbed cost record, never sent to or
  /// payable by a customer. Warranty jobs never reach this model at all (see AftersalesInvoiceService.generate).
  isInternal    Boolean  @default(false)
  /// Who this bills — the customer's name for a RETAIL job, or the dealer's own internal accounts
  /// department for an INTERNAL one. Kept separate from JobCard.customerName so the invoice record
  /// is self-contained even if the job card is later changed.
  recipient     String?
  labourTotal   Decimal  @default(0) @db.Decimal(10, 2)
  partsTotal    Decimal  @default(0) @db.Decimal(10, 2)
  vatAmount     Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(10, 2)
  pdfUrl        String?
  createdAt     DateTime @default(now())

  @@map("aftersales_invoices")
}

/// Parts a job card is *expected* to need, entered at booking/estimate time — distinct from
/// PartAllocation, which only exists once stock has actually been taken. Lets the workshop-loading
/// view flag shortfalls against upcoming (not yet started) jobs, before they become a problem on
/// the day. partId is optional so a service advisor can log "need a rear brake disc" before
/// matching it to a specific stocked part.
model JobCardPartRequirement {
  id          String   @id @default(uuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  jobCardId   String
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  partId      String?
  part        Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  description String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  @@map("job_card_part_requirements")
}

model JobCardTimeEntry {
  id           String    @id @default(uuid())
  jobCardId    String
  jobCard      JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User      @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  clockOn      DateTime
  clockOff     DateTime?

  @@map("job_card_time_entries")
}

model CapacityBlock {
  id               String   @id @default(uuid())
  dealerId         String
  dealer           Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  bayId            String
  bay              Bay      @relation(fields: [bayId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  availableMinutes Int      @default(480)
  reason           String?

  @@unique([bayId, date])
  @@map("capacity_blocks")
}

/// A technician's qualification to work a given JobCategory (e.g. a tech can be MECHANICAL +
/// DIAGNOSTICS but not EV). Drives which technicians' hours count toward a category's capacity in
/// TechniciansService.capacityReport — a job needing EV skill can't be covered by a mechanical-only
/// technician's spare hours, however available they are.
model TechnicianSkill {
  id       String      @id @default(uuid())
  dealerId String
  dealer   Dealer      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category JobCategory

  @@unique([userId, category])
  @@map("technician_skills")
}

enum TechnicianAvailabilityStatus {
  AVAILABLE
  LEAVE
  SICKNESS
  TRAINING
  OFF_SHIFT
}

/// The technician calendar/rota (§ "who's in / who's isn't") — one row per technician per day.
/// availableMinutes is only meaningful when status is AVAILABLE; a booked day off, sick day, or
/// training day contributes zero hours to that day's capacity regardless of what's set here.
model TechnicianAvailability {
  id               String                       @id @default(uuid())
  dealerId         String
  dealer           Dealer                       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId           String
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime                     @db.Date
  status           TechnicianAvailabilityStatus @default(AVAILABLE)
  availableMinutes Int                          @default(480)
  note             String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([userId, date])
  @@map("technician_availability")
}

enum ServiceBookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model ServiceBooking {
  id             String               @id @default(uuid())
  dealerId       String
  dealer         Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerName   String
  contactEmail   String?
  contactPhone   String?
  vehicleReg     String
  serviceType    String
  requestedSlot  DateTime
  status         ServiceBookingStatus @default(REQUESTED)
  reminderSentAt DateTime?
  createdAt      DateTime             @default(now())

  @@map("service_bookings")
}

// ---------------------------------------------------------------------------
// Module 3 — Parts Stock Management
// ---------------------------------------------------------------------------

model Part {
  id             String   @id @default(uuid())
  dealerId       String
  dealer         Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  partNumber     String
  description    String
  binLocation    String?
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  costPrice      Decimal  @default(0) @db.Decimal(10, 2)
  /// Values for CustomFieldDefinition(entity: PART) — see Vehicle.customFields.
  customFields   Json     @default("{}")
  createdAt      DateTime @default(now())

  movements           StockMovement[]
  allocations         PartAllocation[]
  poLines             PurchaseOrderLine[]
  jobCardRequirements JobCardPartRequirement[]
  vhcItemParts        VhcItemPart[]

  @@unique([dealerId, partNumber])
  @@map("parts")
}

enum StockMovementType {
  GOODS_RECEIVED
  ALLOCATED
  RETURNED
  WRITE_OFF
}

model StockMovement {
  id         String            @id @default(uuid())
  dealerId   String
  dealer     Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  partId     String
  part       Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  type       StockMovementType
  quantity   Int
  reasonCode String?
  reference  String?
  createdAt  DateTime          @default(now())

  @@map("stock_movements")
}

model PartAllocation {
  id        String   @id @default(uuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  jobCardId String
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())

  @@map("part_allocations")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

model PurchaseOrder {
  id        String              @id @default(uuid())
  dealerId  String
  dealer    Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  supplier  String
  status    PurchaseOrderStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  lines PurchaseOrderLine[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  partId           String
  part             Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(10, 2)

  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// Module 4 — Used Car Sales
// ---------------------------------------------------------------------------

enum UsedVehicleStatus {
  IN_STOCK
  LISTED
  RESERVED
  SOLD
  DELIVERED
}

enum VehicleSource {
  PART_EX
  TRADE_BUY
  AUCTION
  OTHER
}

model UsedVehicle {
  id                String            @id @default(uuid())
  dealerId          String
  dealer            Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  reg               String
  vin               String?
  make              String
  model             String
  colour            String?
  mileage           Int?
  fuel              String?
  transmission      String?
  purchasePrice     Decimal?          @db.Decimal(10, 2)
  askingPrice       Decimal?          @db.Decimal(10, 2)
  source            VehicleSource     @default(OTHER)
  status            UsedVehicleStatus @default(IN_STOCK)
  listedAt          DateTime?
  soldAt            DateTime?
  v5cDocumentUrl    String?
  serviceHistoryUrl String?
  hpiReportUrl      String?
  /// Values for CustomFieldDefinition(entity: USED_VEHICLE) — see Vehicle.customFields.
  customFields      Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  photos               VehiclePhoto[]
  priceHistory         PriceHistoryEntry[]
  leads                Lead[]
  appraisal            PartExchangeAppraisal?
  dealSheets           DealSheet[]
  handoverAppointments HandoverAppointment[]
  listings             VehicleListing[]
  financeProducts      DealFinanceProduct[]

  @@unique([dealerId, reg])
  @@map("used_vehicles")
}

model VehiclePhoto {
  id            String      @id @default(uuid())
  usedVehicleId String
  usedVehicle   UsedVehicle @relation(fields: [usedVehicleId], references: [id], onDelete: Cascade)
  url           String
  sortOrder     Int         @default(0)

  @@map("vehicle_photos")
}

model PriceHistoryEntry {
  id            String      @id @default(uuid())
  usedVehicleId String
  usedVehicle   UsedVehicle @relation(fields: [usedVehicleId], references: [id], onDelete: Cascade)
  price         Decimal     @db.Decimal(10, 2)
  changedAt     DateTime    @default(now())

  @@map("price_history_entries")
}

/// Appraisal of a customer's incoming trade-in vehicle — usedVehicleId is the NEW stock record the
/// trade-in becomes (source: PART_EX); dealSheetId/newCarSaleId say which sale generated it, so a
/// trade-in works identically whether the customer is buying a used car or a new one (retail or
/// agency — see NewCarSale). At most one of dealSheetId/newCarSaleId is set; both are optional so
/// an appraisal can still be recorded standalone against an already-existing used vehicle, same as
/// before this pass.
model PartExchangeAppraisal {
  id            String      @id @default(uuid())
  usedVehicleId String      @unique
  usedVehicle   UsedVehicle @relation(fields: [usedVehicleId], references: [id], onDelete: Cascade)
  dealSheetId   String?     @unique
  dealSheet     DealSheet?  @relation(fields: [dealSheetId], references: [id], onDelete: SetNull)
  newCarSaleId  String?     @unique
  newCarSale    NewCarSale? @relation(fields: [newCarSaleId], references: [id], onDelete: SetNull)
  condition     String?
  mileage       Int?
  damageNotes   String?
  photoUrls     String[]
  agreedValue   Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  @@map("part_exchange_appraisals")
}

/// A deal sheet that didn't result in a signed sale must be INVALIDATED (never deleted, for audit
/// trail) before the same vehicle can get a new one — enforced in UsedCarsService, not by a DB
/// constraint, since Postgres/Prisma don't support a clean "only one ACTIVE row" filtered unique
/// index across schema-level tooling here. A vehicle can therefore have many DealSheet rows over
/// time (one per attempt), which is why this is no longer a 1:1 relation to UsedVehicle.
enum DealSheetStatus {
  ACTIVE
  SIGNED
  INVALIDATED
}

model DealSheet {
  id                  String          @id @default(uuid())
  usedVehicleId       String
  usedVehicle         UsedVehicle     @relation(fields: [usedVehicleId], references: [id], onDelete: Cascade)
  status              DealSheetStatus @default(ACTIVE)
  sellingPrice        Decimal         @db.Decimal(10, 2)
  partExchangeValue   Decimal?        @db.Decimal(10, 2)
  financeContribution Decimal?        @db.Decimal(10, 2)
  /// Sum of accessoryLines — kept as a stored column for fast reporting, recomputed whenever lines change.
  accessoriesTotal    Decimal         @default(0) @db.Decimal(10, 2)
  grossProfit         Decimal?        @db.Decimal(10, 2)
  pdfUrl              String?
  invalidatedAt       DateTime?
  invalidatedReason   String?
  createdAt           DateTime        @default(now())

  accessoryLines DealAccessoryLine[]
  tradeIn        PartExchangeAppraisal?

  @@map("deal_sheets")
}

/// Itemised "dealer accessories" line on the deal sheet (Feature Spec §4.5) — e.g. "Mudflaps £50".
model DealAccessoryLine {
  id          String    @id @default(uuid())
  dealSheetId String
  dealSheet   DealSheet @relation(fields: [dealSheetId], references: [id], onDelete: Cascade)
  description String
  price       Decimal   @db.Decimal(10, 2)

  @@map("deal_accessory_lines")
}

// ---------------------------------------------------------------------------
// Module 5 — Warranty
// ---------------------------------------------------------------------------

enum WarrantyClaimStatus {
  DRAFT
  SUBMITTED
  AUTHORISED
  REJECTED
  PAID
}

model WarrantyClaim {
  id                  String              @id @default(uuid())
  dealerId            String
  dealer              Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleId           String
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId           String?             @unique
  jobCard             JobCard?            @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  customerName        String
  faultDescription    String
  symptomCode         String?
  status              WarrantyClaimStatus @default(DRAFT)
  awpAuthorisationRef String?
  /// Set automatically the moment the claim moves to SUBMITTED (see WarrantyService.updateStatus) —
  /// the only record of when it was actually sent to the OEM/AWP, distinct from createdAt.
  submittedAt         DateTime?
  rejectionReason     String?
  expectedPayment     Decimal?            @db.Decimal(10, 2)
  actualPayment       Decimal?            @db.Decimal(10, 2)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  operationLines WarrantyOperationLine[]

  @@map("warranty_claims")
}

model WarrantyOperationLine {
  id              String        @id @default(uuid())
  warrantyClaimId String
  warrantyClaim   WarrantyClaim @relation(fields: [warrantyClaimId], references: [id], onDelete: Cascade)
  operationCode   String
  description     String
  standardMinutes Int
  cause           String?
  correction      String?
  complaint       String?
  labourWriteUp   String?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime      @default(now())

  clockEntries WarrantyClockEntry[]

  @@map("warranty_operation_lines")
}

model WarrantyClockEntry {
  id           String                @id @default(uuid())
  lineId       String
  line         WarrantyOperationLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User                  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  clockOn      DateTime
  clockOff     DateTime?

  @@map("warranty_clock_entries")
}

// ---------------------------------------------------------------------------
// Module 8 — CRM & Customer Communications
// ---------------------------------------------------------------------------

enum ContactStatus {
  PROSPECT
  CUSTOMER
}

model Contact {
  id           String        @id @default(uuid())
  dealerId     String
  dealer       Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String?
  phone        String?
  status       ContactStatus @default(PROSPECT)
  gdprConsent  Boolean       @default(false)
  emailOptIn   Boolean       @default(true)
  smsOptIn     Boolean       @default(true)
  /// Values for CustomFieldDefinition(entity: CONTACT) — see Vehicle.customFields.
  customFields Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  leads               Lead[]
  activities          CrmActivity[]
  tasks               CrmTask[]
  emails              EmailMessage[]
  smsMessages         SmsMessage[]
  jobCards            JobCard[]
  workflowEnrollments WorkflowEnrollment[]
  invoices            CustomerInvoice[]

  @@map("contacts")
}

/// Ad-hoc customer-support invoicing (goodwill gestures, admin fees, lost-key/remote charges) —
/// distinct from AftersalesInvoice, which is always tied to a workshop JobCard. Raised directly
/// against a CRM Contact through the same document-template/sequence engine as every other AMX
/// document, so a dealer can override its layout the same way.
model CustomerInvoice {
  id            String   @id @default(uuid())
  dealerId      String
  dealer        Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  invoiceNumber String
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  vatAmount     Decimal  @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)
  pdfUrl        String?
  createdAt     DateTime @default(now())

  @@map("customer_invoices")
}

enum LeadStage {
  ENQUIRY
  CONTACTED
  TEST_DRIVE
  OFFER
  RESERVED
  SOLD
  LOST
}

enum LeadSource {
  WEBSITE_FORM
  BMW_CRM
  EMAIL
  MANUAL
  CHATBOT
  PHONE
}

model Lead {
  id                    String       @id @default(uuid())
  dealerId              String
  dealer                Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  contactId             String
  contact               Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  usedVehicleId         String?
  usedVehicle           UsedVehicle? @relation(fields: [usedVehicleId], references: [id], onDelete: SetNull)
  stage                 LeadStage    @default(ENQUIRY)
  source                LeadSource   @default(MANUAL)
  assignedSalespersonId String?
  assignedSalesperson   User?        @relation("AssignedSalesperson", fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  lostReason            String?
  score                 Int?         @default(0)
  scoreReasons          String[]
  lastActivityAt        DateTime?    @default(now())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  activities          CrmActivity[]
  tasks               CrmTask[]
  workflowEnrollments WorkflowEnrollment[]

  @@map("leads")
}

enum CrmActivityType {
  CALL
  MEETING
  NOTE
  EMAIL
  SMS
  STAGE_CHANGE
}

model CrmActivity {
  id        String          @id @default(uuid())
  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      CrmActivityType
  notes     String?
  createdAt DateTime        @default(now())

  @@map("crm_activities")
}

model CrmTask {
  id                 String    @id @default(uuid())
  contactId          String?
  contact            Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId         String
  assignee           User      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  title              String
  dueDate            DateTime
  completedAt        DateTime?
  overdueAlertSentAt DateTime?
  createdAt          DateTime  @default(now())

  @@map("crm_tasks")
}

enum TemplateCategory {
  INITIAL_ENQUIRY
  FOLLOW_UP
  TEST_DRIVE_CONFIRMATION
  OFFER_LETTER
  LOST_SALE_RECOVERY
  SERVICE_REMINDER
  OTHER
}

model EmailTemplate {
  id        String           @id @default(uuid())
  dealerId  String
  dealer    Dealer           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  category  TemplateCategory @default(OTHER)
  subject   String
  bodyHtml  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  emails EmailMessage[]

  @@map("email_templates")
}

enum EmailStatus {
  QUEUED
  SENT
  OPENED
  CLICKED
  REPLIED
  FAILED
}

model EmailMessage {
  id         String         @id @default(uuid())
  contactId  String
  contact    Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject    String
  bodyHtml   String
  status     EmailStatus    @default(QUEUED)
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  repliedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@map("email_messages")
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  REPLIED
}

model SmsTemplate {
  id        String   @id @default(uuid())
  dealerId  String
  name      String
  body      String
  createdAt DateTime @default(now())

  @@map("sms_templates")
}

model SmsMessage {
  id        String    @id @default(uuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body      String
  status    SmsStatus @default(QUEUED)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("sms_messages")
}

enum DocumentTemplateType {
  SALES_INVOICE
  PART_EXCHANGE_RECEIPT
  SERVICE_ESTIMATE
  HANDOVER_DOCUMENT
  DEAL_SHEET
  AFTERSALES_INVOICE
  CUSTOMER_SUPPORT_INVOICE
  NEW_CAR_SALE
}

/// Dealer-authored document templates (variables/text/styling/logo) — see DOCUMENT_TEMPLATE_VARIABLES
/// in @project-amx/shared for the mail-merge-style placeholders available per type. Only one
/// template per (dealerId, type) may be flagged isDefault — enforced in DocumentTemplatesService,
/// not the DB, so a dealer can keep drafts/alternates around without deleting them.
/// Dealer-authored document templates (variables/text/styling/logo) — see DOCUMENT_TEMPLATE_VARIABLES
/// in @project-amx/shared for the mail-merge-style placeholders available per type. Configurable
/// at any of the three tenancy levels (`scope` + exactly one of dealerId/franchiseId/groupId set);
/// DocumentTemplatesService.getDefaultBody() resolves the most specific default: DEALER, then
/// FRANCHISE, then GROUP, then a built-in fallback. Only one template per (owner, type) may be
/// isDefault — enforced in DocumentTemplatesService, not the DB.
model DocumentTemplate {
  id          String               @id @default(uuid())
  scope       ConfigScope          @default(DEALER)
  dealerId    String?
  dealer      Dealer?              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  franchiseId String?
  franchise   Franchise?           @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type        DocumentTemplateType
  name        String
  bodyHtml    String
  isDefault   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("document_templates")
}

enum WorkflowTrigger {
  MANUAL
  LEAD_STAGE_ENTERED
  CONTACT_CREATED
  NO_ACTIVITY_DAYS
}

model Workflow {
  id        String          @id @default(uuid())
  dealerId  String
  dealer    Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  trigger   WorkflowTrigger @default(MANUAL)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  steps       WorkflowStep[]
  enrollments WorkflowEnrollment[]

  @@map("workflows")
}

enum WorkflowActionType {
  SEND_EMAIL
  SEND_SMS
  CREATE_TASK
  CHANGE_LEAD_STAGE
  ADD_TAG
  /// Branches the workflow to a different step rather than performing an action of its own.
  CONDITION
}

model WorkflowStep {
  id           String             @id @default(uuid())
  workflowId   String
  workflow     Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sortOrder    Int
  delayHours   Int                @default(0)
  actionType   WorkflowActionType
  actionConfig Json

  @@map("workflow_steps")
}

enum WorkflowEnrollmentStatus {
  ACTIVE
  COMPLETED
  UNENROLLED
}

model WorkflowEnrollment {
  id          String                   @id @default(uuid())
  workflowId  String
  workflow    Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  currentStep Int                      @default(0)
  status      WorkflowEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime                 @default(now())
  nextRunAt   DateTime?

  @@map("workflow_enrollments")
}

// ---------------------------------------------------------------------------
// Module 9 — Digital Vehicle Health Check (VHC)
// ---------------------------------------------------------------------------

/// DRAFT: technician still adding items. COMPLETE: technician has signed off (see VhcService.completeInspection) —
/// a report can only be sent to the customer once here. SENT: emailed, awaiting customer responses.
/// CLOSED: every item has been responded to (approved or declined).
enum VhcInspectionStatus {
  DRAFT
  COMPLETE
  SENT
  CLOSED
}

model VhcInspection {
  id            String              @id @default(uuid())
  dealerId      String
  dealer        Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  jobCardId     String
  jobCard       JobCard             @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  technicianId  String
  vehicleReg    String
  mileage       Int?
  status        VhcInspectionStatus @default(DRAFT)
  /// Technician sign-off — distinct from item creation, gates whether the report can be sent (§9.1 gap fix).
  completedAt   DateTime?
  completedById String?
  reportUrl     String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  items VhcItem[]

  @@map("vhc_inspections")
}

enum VhcRating {
  GREEN
  AMBER
  RED
}

model VhcItem {
  id                     String        @id @default(uuid())
  inspectionId           String
  inspection             VhcInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category               String
  label                  String
  rating                 VhcRating
  description            String?
  photoUrls              String[]
  estimatedLabourMinutes Int?
  /// Manual fallback parts estimate — only used while no real Part is linked via `parts` below.
  /// Once a part is linked, the quote is computed from its actual costPrice instead (see
  /// VhcService.recomputeQuote), which is more accurate than a typed-in guess.
  estimatedPartsCost     Decimal?      @db.Decimal(10, 2)
  /// Auto-quote (§ VHC auto-quote), recomputed by VhcService whenever labour minutes or linked
  /// parts change — looked up from the dealer's own labourRatePerHour and each Part's costPrice,
  /// rather than the technician typing in a guessed price.
  quotedLabourCost       Decimal?      @db.Decimal(10, 2)
  quotedPartsCost        Decimal?      @db.Decimal(10, 2)
  quotedTotal            Decimal?      @db.Decimal(10, 2)
  approved               Boolean?
  respondedAt            DateTime?

  parts VhcItemPart[]

  /// The job card auto-created when the customer approves this item (see VhcService.respondToItem) —
  /// the reverse side of JobCard.sourceVhcItemId, closing what was previously a one-way, unlinked spin-off.
  followUpJobCard JobCard?

  @@map("vhc_items")
}

/// Links a VHC item to a real stocked Part so its cost feeds the auto-quote from an actual price
/// rather than a typed-in guess (see VhcService.recomputeQuote) — the same real-price principle
/// AftersalesInvoiceService already applies to PartAllocation.
model VhcItemPart {
  id       String  @id @default(uuid())
  itemId   String
  item     VhcItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  partId   String
  part     Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  quantity Int     @default(1)

  @@map("vhc_item_parts")
}

