// ---------------------------------------------------------------------------
// OEM Integration Hub — no-code data connectors (REST pull/push, MQTT) with a
// drag-and-drop field mapper and dealer-defined custom fields. Lets a business
// systems manager wire up a manufacturer/DMS feed without writing code.
// ---------------------------------------------------------------------------

enum IntegrationType {
  REST_PULL
  REST_PUSH
  MQTT
}

enum IntegrationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}

/// The AMX entity a connector's inbound records get written into. Deliberately a short,
/// explicit allowlist rather than "any table" — see IntegrationsService's per-entity field
/// allowlist, which this enum also indexes.
enum IntegrationTargetEntity {
  VEHICLE
  USED_VEHICLE
  PART
  CONTACT
}

enum CustomFieldDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
}

enum IntegrationRunStatus {
  SUCCESS
  ERROR
}

model IntegrationConnector {
  id           String                  @id @default(uuid())
  dealerId     String
  dealer       Dealer                  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name         String
  type         IntegrationType
  targetEntity IntegrationTargetEntity
  status       IntegrationStatus       @default(DRAFT)
  /// Type-specific connection config — REST_PULL: {url, method, headers, pollIntervalMinutes,
  /// resultsPath}; REST_PUSH: {resultsPath}; MQTT: {brokerUrl, topic, username, password}.
  config       Json                    @default("{}")
  /// Unguessable, revocable inbound-webhook token for REST_PUSH connectors — the same
  /// "dedicated token, never a plain id" pattern used for the workshop TV board.
  webhookToken String                  @unique @default(uuid())
  /// Target column (or custom field key) used to decide create-vs-update per inbound record,
  /// e.g. "vin" for VEHICLE. Records without a resolvable match value are always created.
  matchField   String?
  lastRunAt    DateTime?
  lastError    String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  mappings IntegrationFieldMapping[]
  runLogs  IntegrationRunLog[]

  @@map("integration_connectors")
}

model IntegrationFieldMapping {
  id            String               @id @default(uuid())
  connectorId   String
  connector     IntegrationConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  /// Dot-path into the inbound payload, e.g. "vehicle.vin" or "items[0].sku".
  sourcePath    String
  /// An allowlisted AMX column name for the connector's targetEntity, or a CustomFieldDefinition
  /// key when isCustomField is true.
  targetField   String
  isCustomField Boolean              @default(false)
  /// Optional value transform applied before writing: UPPERCASE | LOWERCASE | TRIM |
  /// PARSE_NUMBER | PARSE_DATE. Null/unrecognised = copied as-is.
  transform     String?
  sortOrder     Int                  @default(0)

  @@map("integration_field_mappings")
}

model CustomFieldDefinition {
  id        String                  @id @default(uuid())
  dealerId  String
  dealer    Dealer                  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  entity    IntegrationTargetEntity
  /// Machine key stored inside the target row's customFields JSON, e.g. "oemDealerNetCode".
  key       String
  label     String
  dataType  CustomFieldDataType     @default(STRING)
  createdAt DateTime                @default(now())

  @@unique([dealerId, entity, key])
  @@map("custom_field_definitions")
}

model IntegrationRunLog {
  id               String               @id @default(uuid())
  connectorId      String
  connector        IntegrationConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  status           IntegrationRunStatus
  recordsIn        Int                  @default(0)
  recordsMapped    Int                  @default(0)
  errorMessage     String?
  rawPayloadSample Json?
  createdAt        DateTime             @default(now())

  @@map("integration_run_logs")
}

/**
 * One editable "screen" per dealer+entity, built by a business systems manager in the Screen
 * Designer, so custom fields brought in by an integration are actually visible somewhere in the
 * app — not just in raw JSON. `fields` is an ordered array of
 * `{ field: string; label: string; isCustomField: boolean }`, validated the same way a field
 * mapping's targetField is (see IntegrationsService.saveScreen).
 */
model UiScreenDefinition {
  id        String                  @id @default(uuid())
  dealerId  String
  dealer    Dealer                  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  entity    IntegrationTargetEntity
  fields    Json                    @default("[]")
  updatedAt DateTime                @updatedAt

  @@unique([dealerId, entity])
  @@map("ui_screen_definitions")
}

/// A user-facing lookup function (e.g. searching a used car by registration) that a business
/// systems manager has configured to also call an external API and merge its response, alongside
/// the normal database search — see ActionTriggersService. Configurable at any of the three
/// tenancy levels, same resolution rule as DocumentTemplate: DEALER, then FRANCHISE, then GROUP.
enum ActionTriggerPoint {
  USED_VEHICLE_REG_LOOKUP
}

model ActionTrigger {
  id           String                  @id @default(uuid())
  scope        ConfigScope             @default(DEALER)
  dealerId     String?
  dealer       Dealer?                 @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  franchiseId  String?
  franchise    Franchise?              @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  triggerPoint ActionTriggerPoint
  active       Boolean                 @default(true)
  targetEntity IntegrationTargetEntity
  /// REST call config: urlTemplate (with a `{value}` placeholder), method, headers, auth — same
  /// shape as IntegrationConnector's REST_PULL config (see rest-auth.util.ts), reused as-is.
  config       Json                    @default("{}")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  mappings ActionTriggerMapping[]

  @@map("action_triggers")
}

/// Maps a field from the external API's response onto an AMX column or custom field — identical
/// shape/semantics to IntegrationFieldMapping, reusing field-mapping.util's resolvePath/applyTransform.
model ActionTriggerMapping {
  id              String        @id @default(uuid())
  actionTriggerId String
  actionTrigger   ActionTrigger @relation(fields: [actionTriggerId], references: [id], onDelete: Cascade)
  sourcePath      String
  targetField     String
  isCustomField   Boolean       @default(false)
  transform       String?
  sortOrder       Int           @default(0)

  @@map("action_trigger_mappings")
}
