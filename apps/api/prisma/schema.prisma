enum CourtesyVehicleStatus {
  AVAILABLE
  ON_LOAN
  OFF_ROAD
  IN_FOR_SERVICE
}

model CourtesyVehicle {
  id              String                @id @default(uuid())
  dealerId        String
  dealer          Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  reg             String
  make            String
  model           String
  colour          String?
  mileage         Int?
  insuranceExpiry DateTime?
  motExpiry       DateTime?
  taxExpiry       DateTime?
  status          CourtesyVehicleStatus @default(AVAILABLE)

  bookings CourtesyBooking[]

  @@unique([dealerId, reg])
  @@map("courtesy_vehicles")
}

model CourtesyBooking {
  id                   String          @id @default(uuid())
  courtesyVehicleId    String
  courtesyVehicle      CourtesyVehicle @relation(fields: [courtesyVehicleId], references: [id], onDelete: Cascade)
  customerName         String
  linkedJobCardId      String?
  outDate              DateTime
  expectedReturnDate   DateTime
  outMileage           Int?
  returnMileage        Int?
  actualReturnDate     DateTime?
  handoverConditionUrl String?
  returnConditionUrl   String?
  handoverSignatureUrl String?
  returnSignatureUrl   String?
  newDamageNotes       String?
  createdAt            DateTime        @default(now())

  conditionReports VehicleConditionReport[]

  @@map("courtesy_bookings")
}

/// A structured, itemised condition/damage check — shared by courtesy/loan car bookings (INITIAL
/// when the car leaves with the customer, FINAL when it's returned) and workshop job cards
/// (INITIAL when the customer's own car is dropped off, FINAL when it's handed back), rather than
/// duplicating this per module. Exactly one of courtesyBookingId/jobCardId is set — enforced in
/// VehicleConditionService, not the DB, same pattern as other optional-parent links in this schema.
enum ConditionCheckStage {
  INITIAL
  FINAL
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
}

model VehicleConditionReport {
  id                String              @id @default(uuid())
  dealerId          String
  dealer            Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  courtesyBookingId String?
  courtesyBooking   CourtesyBooking?    @relation(fields: [courtesyBookingId], references: [id], onDelete: Cascade)
  jobCardId         String?
  jobCard           JobCard?            @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  stage             ConditionCheckStage
  mileage           Int?
  notes             String?
  photoUrls         String[]
  createdAt         DateTime            @default(now())

  damageMarkers VehicleDamageMarker[]

  @@map("vehicle_condition_reports")
}

/// One itemised damage entry within a condition report — e.g. "front-left door, scuff, MINOR".
model VehicleDamageMarker {
  id                String                 @id @default(uuid())
  conditionReportId String
  conditionReport   VehicleConditionReport @relation(fields: [conditionReportId], references: [id], onDelete: Cascade)
  location          String
  description       String
  severity          DamageSeverity         @default(MINOR)
  photoUrl          String?

  @@map("vehicle_damage_markers")
}

