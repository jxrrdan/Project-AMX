# Copy to .env and adjust for your local environment.
# In AWS, these are supplied via ECS task definitions / Secrets Manager — see infra/cdk.

# --- Database (Aurora PostgreSQL Serverless v2 in production; local Postgres via docker-compose) ---
DATABASE_URL="postgresql://ams:ams_local_password@localhost:5432/ams?schema=public"

# --- Auth (stands in for AWS Cognito locally — see docs/architecture.md) ---
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# --- Redis (ElastiCache in production — pub/sub for live workshop board updates) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3000
WEB_PORT=4200
CORS_ORIGIN="http://localhost:4200"

# --- File storage (AWS S3 in production; local filesystem adapter for dev — see StorageService) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.data/storage"
AWS_S3_BUCKET="ams-files"
AWS_REGION="eu-west-2"

# --- Email (AWS SES in production; console/log adapter for dev — see EmailService) ---
EMAIL_DRIVER="console"
SES_FROM_ADDRESS="no-reply@ams-app.co.uk"

# --- SMS (AWS SNS / Twilio in production; console/log adapter for dev — see SmsService) ---
SMS_DRIVER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- AI (Amazon Bedrock / Claude in production; mock adapter for dev — see AiService) ---
AI_DRIVER="mock"
BEDROCK_REGION="eu-west-2"
BEDROCK_REASONING_MODEL="anthropic.claude-sonnet-4-6"
BEDROCK_LIGHTWEIGHT_MODEL="anthropic.claude-haiku-4-5"

# --- DVLA (Vehicle Enquiry Service in production; mock adapter for dev — see DvlaService) ---
DVLA_DRIVER="mock"
DVLA_API_KEY=""

# --- CAPTCHA for public forms (enquiry, service booking — see CaptchaService) ---
# local: dependency-free signed arithmetic challenge (default, works offline).
# turnstile: verify a Cloudflare Turnstile widget token server-side (production).
CAPTCHA_DRIVER="local"
CAPTCHA_SECRET="dev-captcha-secret-change-me"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# --- BMW integrations (mocked locally — see MqttIngestService / RisPollingService) ---
BMW_RIS_MQTT_HOST=""
BMW_RIS_MQTT_CLIENT_ID=""
AWP_WEBHOOK_SECRET="dev-awp-webhook-secret"

# --- Security (see docs/SECURITY.md) ---
# Signs the customer VHC report links. Falls back to JWT_ACCESS_SECRET; set a distinct value in production.
VHC_LINK_SECRET="dev-vhc-link-secret-change-me"
# Public base URL of the web app, used in emailed links.
PUBLIC_WEB_URL="http://localhost:4200"
# Set to "true" (or a hop count / CIDR) when running behind ALB/CloudFront so rate limits key on the real client IP.
TRUST_PROXY=""
# Sign-in lockout: failures before locking, and how long. AUTH_LOCKOUT_MINUTES is a number of minutes,
# or 0 / "indefinite" to stay locked until an admin calls POST /users/:id/unlock.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
