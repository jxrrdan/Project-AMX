# === AMX Backend Configuration ===

# Application
APP_NAME="AMX Agent Management System"
DEBUG=false

# Multi-tenancy — set per deployment
DEALER_GROUP_ID=your-dealer-group-id

# MongoDB (change to Atlas URI for production)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=amx

# Security — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# MQTT Broker (OEM connection details)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CLIENT_ID=amx-backend
MQTT_TOPIC_PREFIX=amx

# DVLA Vehicle Enquiry Service
# Register at: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=["http://localhost:5173"]

# Feature flags
MQTT_ENABLED=true
WEBSOCKET_ENABLED=true
